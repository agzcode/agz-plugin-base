{
	"name": "my-plugin",
	"version": "0.1.0",
	"description": "A starting point for a plugin with a panel view and a tool card.",
	"type": "module",
	"license": "MIT",
	"files": ["extensions", "README.md"],
	"engines": {
		"agz-plugin-sdk": "^1.1.0"
	},
	"scripts": {
		"test": "agz plugin test"
	},
	"devDependencies": {
		"@agz-yazilim/plugin-kit": "1.4.0",
		"@agz-yazilim/plugin-sdk": "1.4.0",
		"@types/node": "22.19.19",
		"typescript": "7.0.2"
	},
	"agzPlugin": {
		"schemaVersion": 1,
		"id": "my-publisher/my-plugin",
		"name": "My Plugin",
		"description": "A starting point for a plugin with a panel view and a tool card.",
		"extensions": ["extensions/index.ts"],
		"ui": {
			"views": [
				{
					"id": "tasks",
					"title": { "en": "Tasks", "tr": "Görevler" },
					"icon": "list-checks",
					"place": "panel"
				}
			],
			"toolViews": [
				{
					"tool": "my_plugin_add_task",
					"title": { "en": "Add task", "tr": "Görev ekle" },
					"subject": { "from": "args", "key": "title" },
					"facts": [{ "label": { "en": "Open tasks", "tr": "Açık görevler" }, "from": "result", "key": "open" }]
				}
			]
		}
	}
}
